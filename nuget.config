<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- dvx restores only from nuget.org (SPEC §11); machine-level feeds are ignored. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
