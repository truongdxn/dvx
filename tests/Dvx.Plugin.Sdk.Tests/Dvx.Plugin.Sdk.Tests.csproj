  <Import Project="..\..\src\Dvx.Plugin.Sdk\Dvx.Plugin.Sdk.projitems" Label="Shared" />
  <Import Project="..\..\src\Dvx.Testing\Dvx.Testing.projitems" Label="Shared" />
</Project>
