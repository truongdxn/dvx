<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <AssemblyName>SpikePlugins</AssemblyName>
    <RootNamespace>SpikePlugins</RootNamespace>
    <!-- Directory.Build.props conditions on TargetFramework are evaluated before this file sets it, so set explicitly. -->
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CrmSdk.CoreAssemblies" />
  </ItemGroup>
  <!-- Source-inclusion pattern: consumers compile the SDK as a shared project, as the real product does. -->
  <Import Project="..\Sdk\Sdk.projitems" Label="Shared" />
</Project>
