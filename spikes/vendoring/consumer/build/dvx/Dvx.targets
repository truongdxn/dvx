<Project>
  <!-- Vendored by dvx. Runs no dvx command during build. -->
  <PropertyGroup>
    <DvxAnalyzerPath>$(MSBuildThisFileDirectory)analyzers/Dvx.Analyzers.dll</DvxAnalyzerPath>
  </PropertyGroup>

  <!-- Plugin projects: <DvxProjectKind>Plugin</DvxProjectKind> (SPEC 4.2). Test projects: <DvxProjectKind>Test</DvxProjectKind>. -->
  <ItemGroup Condition="'$(DvxProjectKind)' == 'Plugin' Or '$(DvxProjectKind)' == 'Test'">
    <Analyzer Include="$(DvxAnalyzerPath)" />
  </ItemGroup>

  <!-- SPIKE-ONLY: DvxSpikeNoIvt exists solely to demonstrate the CS0122 negative case.
       It must NOT ship in the real Dvx.targets (Task 18). -->
  <ItemGroup Condition="'$(DvxProjectKind)' == 'Plugin' And '$(DvxSpikeNoIvt)' != 'true'">
    <InternalsVisibleTo Include="$(AssemblyName).Tests" />
  </ItemGroup>

  <!-- FakeItEasy for test projects, three consumer cases:
       1. central package management, consumer has no FakeItEasy pin: vendor a PackageVersion + version-less reference
       2. central package management, consumer already pins FakeItEasy: version-less reference only (consumer pin wins;
          a second PackageVersion would raise NU1506)
       3. no central package management: reference with a Version attribute (version-less would raise NU1604) -->
  <ItemGroup Condition="'$(DvxProjectKind)' == 'Test' And '$(ManagePackageVersionsCentrally)' == 'true'">
    <_DvxFakeItEasyPin Include="@(PackageVersion->WithMetadataValue('Identity', 'FakeItEasy'))" />
  </ItemGroup>
  <ItemGroup Condition="'$(DvxProjectKind)' == 'Test' And '$(ManagePackageVersionsCentrally)' == 'true' And '@(_DvxFakeItEasyPin)' == ''">
    <PackageVersion Include="FakeItEasy" Version="9.0.1" />
  </ItemGroup>
  <ItemGroup Condition="'$(DvxProjectKind)' == 'Test' And '$(ManagePackageVersionsCentrally)' == 'true'">
    <PackageReference Include="FakeItEasy" />
  </ItemGroup>
  <ItemGroup Condition="'$(DvxProjectKind)' == 'Test' And '$(ManagePackageVersionsCentrally)' != 'true'">
    <PackageReference Include="FakeItEasy" Version="9.0.1" />
  </ItemGroup>
</Project>
